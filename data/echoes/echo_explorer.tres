stats_override = {"name": "Echo of an Explorer", "stats": {"AP": 34, "AC": 70, "HP": 640, "DP": 16, "HV": 25}, "exp": 900, "tm": 160, "galder": [80, 200], "walk_speed": 96.0, "run_speed": 140.0}
runes = Array[ExtResource("2_c")]([ExtResource("r_fan_of_knives"), ExtResource("r_stone_strike")])
