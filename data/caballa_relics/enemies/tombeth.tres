[gd_resource type="Resource" script_class="EnemyData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="1_s"]
[ext_resource type="Resource" path="res://data/materials/gold.tres" id="m_mat"]
[ext_resource type="Resource" path="res://data/attacks/slam.tres" id="atk"]
[ext_resource type="PackedScene" path="res://scenes/boss_tombeth.tscn" id="2_scene"]
[ext_resource type="Script" path="res://scripts/data/boss_data.gd" id="b_s"]
[ext_resource type="Resource" path="res://data/caballa_relics/enemies/chimu.tres" id="e_chimu"]
[ext_resource type="Resource" path="res://data/caballa_relics/enemies/naranjo.tres" id="e_naranjo"]

[sub_resource type="Resource" id="boss_row"]
script = ExtResource("b_s")
lives = 3
heals = Array[Dictionary]([{"lives": 2, "share": 0.06, "every": 6.0}, {"lives": 0, "share": 0.16, "every": 1.5}])
line_open = "I will show you hell.."
line_summon = "Come out!"
line_rage = "KlaAtu Bar.aDa NikTo"
title = "Keeper of the Trident Maze"
summons = {&"minion": ExtResource("e_chimu"), &"brute": ExtResource("e_naranjo")}

[resource]
script = ExtResource("1_s")
id = &"tombeth"
monster_id = "2072"
attack = ExtResource("atk")
body_radius = 30.0
cost = 0
min_depth = 0
hp_mult = 3.8
is_boss = true
boss = SubResource("boss_row")
scene = ExtResource("2_scene")
material = ExtResource("m_mat")
