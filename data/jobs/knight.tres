[resource]
script = ExtResource("1_s")
id = &"knight"
display_name = "Knight"
actor = "knight"
technique = &"whirlwind"
technique_name = "Whirlwind"
technique_text = "Your combo finisher is a full spin with longer reach: it hits everything around you."
bonus_points = {"power": 2, "charm": 2}
graph = {"power": 0.45, "charm": 0.35, "sense": 0.1, "magic": 0.1}
tier = 2
cards = Array[ExtResource("2_c")]([ExtResource("c_lacerator"), ExtResource("c_piercing_wave"), ExtResource("c_inferno_blade"), ExtResource("c_lightning_strike"), ExtResource("c_berserker")])
passive = &"sword_mastery"
passive_name = "Sword Mastery"
passive_text = "Your sword combo deals 15% more damage."
text = "Versatile in combat. Not as powerful as a Boxer, but a Knight attacks many targets at once."
next_jobs = Array[ExtResource("1_s")]([ExtResource("j_gladiator"), ExtResource("j_mercenary")])
