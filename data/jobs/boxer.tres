[ext_resource type="Resource" path="res://data/jobs/duelist.tres" id="j_duelist"]

[resource]
script = ExtResource("1_s")
id = &"boxer"
display_name = "Boxer"
outfit = {"w1": 6, "w4": 5}
technique = &"footwork"
technique_name = "Footwork"
technique_text = "Your dash ends in a jab, and your combo is 15% faster."
bonus_points = {"power": 2, "sense": 2}
graph = {"power": 0.4, "sense": 0.35, "charm": 0.15, "magic": 0.1}
tier = 2
cards = Array[ExtResource("2_c")]([ExtResource("c_uppercut"), ExtResource("c_quad_punch"), ExtResource("c_counter_punch"), ExtResource("c_guard")])
passive = &"boxers_footwork"
passive_name = "Boxer's Footwork"
passive_text = "Your punches deal 15% more damage."
text = "Trained for man-to-man battle: big damage to one enemy at a time."
next_jobs = Array[ExtResource("1_s")]([ExtResource("j_champion"), ExtResource("j_duelist")])
