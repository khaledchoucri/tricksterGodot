[gd_resource type="Resource" script_class="JobData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/job_data.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/data/card_data.gd" id="2_c"]
[ext_resource type="Resource" path="res://data/coral_beach/cards/uppercut.tres" id="c_uppercut"]
[ext_resource type="Resource" path="res://data/coral_beach/cards/quad_punch.tres" id="c_quad_punch"]
[ext_resource type="Resource" path="res://data/coral_beach/cards/counter_punch.tres" id="c_counter_punch"]
[ext_resource type="Resource" path="res://data/coral_beach/cards/guard.tres" id="c_guard"]
