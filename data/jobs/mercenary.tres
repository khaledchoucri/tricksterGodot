[resource]
script = ExtResource("1_s")
id = &"mercenary"
display_name = "Mercenary"
actor = "power_m"
technique = &"blade_dash"
technique_name = "Blade Dash"
technique_text = "Your dash cuts through every monster in its path. A kill with it recharges the dash."
