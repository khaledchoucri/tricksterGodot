graph = {"power": 0.35, "magic": 0.35, "sense": 0.15, "charm": 0.15}
tier = 3
cards = Array[ExtResource("2_c")]([ExtResource("c_uppercut"), ExtResource("c_quad_punch"), ExtResource("c_counter_punch"), ExtResource("c_guard")])
