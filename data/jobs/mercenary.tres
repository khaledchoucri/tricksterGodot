passive_name = "Hired Blade"
passive_text = "You take 10% less damage."
text = "Learns Boxer skills too: two jobs' trees at the expense of new skills."
unlock_stat = "clears_gladiator"
unlock_count = 1
unlock_text = "Clear a run as a Gladiator to unlock."
